---
import Layout from "../layouts/Layout.astro";
import Works from "../components/Works.astro";
import "../styles/global.css";

export function getStaticPaths() {
  return [
    { params: { type: "todos" } },
    { params: { type: "full" } },
    { params: { type: "front" } },
    { params: { type: "back" } },
  ];
}

const filtro = Astro.params.type || "todos";
---

<Layout>
  <section class="flex-grow flex flex-col justify-start text-cyan-50 max-w-6xl mx-auto w-full px-4 mt-8">
    
    <div class="mb-10">
      <h1 class="text-4xl md:text-5xl font-extrabold text-center mb-8 flex items-center justify-center gap-4">
        <span class="h-px w-10 md:w-20 bg-indigo-400/50"></span>
        Mis Proyectos
        <span class="h-px w-10 md:w-20 bg-indigo-400/50"></span>
      </h1>

      <form id="form" class="flex flex-wrap justify-center gap-3">
        {
          [
            { id: "todos", label: "Todos" },
            { id: "full", label: "Full-Stack" },
            { id: "front", label: "Front-End" },
            { id: "back", label: "Back-End" },
          ].map(({ id, label }) => {
            const isChecked = filtro === id;
            return (
              <label
                for={id}
                class={`cursor-pointer px-5 py-2 rounded-full border text-sm font-medium transition-all duration-300
                  ${isChecked 
                    ? "bg-indigo-500/20 text-indigo-300 border-indigo-400 shadow-[0_0_15px_rgba(129,140,248,0.3)]" 
                    : "border-indigo-400/30 text-indigo-200/70 hover:border-indigo-400 hover:text-indigo-300"
                  }
                `}
              >
                <input type="radio" name="filtro" id={id} class="sr-only peer" checked={isChecked} />
                {label}
              </label>
            );
          })
        }
      </form>
    </div>

    <Works filtro={filtro} />
  </section>
</Layout>

<script is:inline>
  const form = document.getElementById("form");
  if (form) {
    form.addEventListener("change", (e) => {
      const filtro = e.target?.id;
      if (filtro) {
        window.location.replace(`/${filtro}-projects`);
      }
    });
  }
</script>